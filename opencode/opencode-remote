#!/usr/bin/env bash
# Fetch AWS credentials from ada cred serve (port-forwarded) and launch opencode.
# Usage: opencode-remote
# Requires: ssh -R 9922:localhost:9922 to forward ada cred serve

CRED_URL="${AWS_CONTAINER_CREDENTIALS_FULL_URI:-http://127.0.0.1:9922}"

# Fetch credentials from the ada cred serve endpoint
CREDS=$(curl -s "$CRED_URL" 2>/dev/null)

if [ -z "$CREDS" ]; then
  echo "ERROR: Could not fetch credentials from $CRED_URL"
  echo "Make sure:"
  echo "  1. 'ada cred serve --profile far-asimov --port 9922' is running on your local machine"
  echo "  2. SSH port forwarding is active: ssh -R 9922:localhost:9922 ..."
  exit 1
fi

# Parse credentials (handles both ada cred serve JSON formats)
export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('AccessKeyId', d.get('accessKeyId', '')))" 2>/dev/null)
export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('SecretAccessKey', d.get('secretAccessKey', '')))" 2>/dev/null)
export AWS_SESSION_TOKEN=$(echo "$CREDS" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('Token', d.get('SessionToken', d.get('sessionToken', ''))))" 2>/dev/null)
export AWS_REGION="${AWS_REGION:-us-east-1}"

# Don't let local AWS config interfere
export AWS_SHARED_CREDENTIALS_FILE="/dev/null"
export AWS_CONFIG_FILE="/dev/null"

if [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ]; then
  echo "ERROR: Failed to parse credentials from $CRED_URL"
  echo "Response was: $CREDS"
  exit 1
fi

echo "AWS credentials loaded from $CRED_URL"
echo "Region: $AWS_REGION"

exec opencode "$@"
